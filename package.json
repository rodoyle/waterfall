{
  "name": "waterfall",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "precommit": "lint-staged",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write . && cargo fmt --all",
    "format:check": "biome format . && cargo fmt --all --check",
    "lint": "biome lint --error-on-warnings . && bun run lint:rust",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "check": "biome check --error-on-warnings . && cargo fmt --all --check && bun run lint:rust",
    "check:fix": "biome check --write . && cargo fmt --all",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "latest",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "playwright": "^1.63.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
